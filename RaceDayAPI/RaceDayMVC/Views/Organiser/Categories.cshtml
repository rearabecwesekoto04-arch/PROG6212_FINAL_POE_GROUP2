@model List<RaceDayMVC.Models.CategoryVm>
@{
    ViewData["Title"] = "Categories";
    int eventId = ViewBag.EventId ?? 0;
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Back</a>
    <h1 class="fw-bold mb-4">Categories</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            @TempData["Success"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible">
            @TempData["Error"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white"><h5 class="mb-0">Existing (@Model.Count)</h5></div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <p class="text-muted mb-0">No categories yet.</p>
                    }
                    else
                    {
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr><th>Name</th><th>Type</th><th>Details</th><th>Price</th><th>Max</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr>
                                        <td><strong>@c.CategoryName</strong></td>
                                        <td><span class="badge bg-secondary">@c.CategoryType</span></td>
                                        <td>
                                            @if (c.CategoryType == "Distance")
                                            {
                                                <span>@c.DistanceKm km</span>
                                            }
                                            else
                                            {
                                                <span>@c.MinAge – @c.MaxAge</span>
                                            }
                                        </td>
                                        <td>R @c.Price.ToString("F2")</td>
                                        <td>@(c.MaxParticipants?.ToString() ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white"><h5 class="mb-0">Add Category</h5></div>
                <div class="card-body">
                    <form asp-action="AddCategory" asp-route-eventId="@eventId" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Name *</label>
                            <input name="CategoryName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category Type *</label>
                            <select name="CategoryType" id="catType" class="form-select" required>
                                <option value="Distance">Distance</option>
                                <option value="Age">Age Group</option>
                            </select>
                        </div>
                        <div id="distanceFields">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Distance (km)</label>
                                <input name="DistanceKm" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div id="ageFields" style="display:none">
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-bold">Min Age</label>
                                    <input name="MinAge" type="number" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-bold">Max Age</label>
                                    <input name="MaxAge" type="number" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Price (R) *</label>
                            <input name="Price" type="number" step="0.01" value="0" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Max Participants</label>
                            <input name="MaxParticipants" type="number" class="form-control" />
                        </div>
                        <button class="btn btn-success w-100">Add Category</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('catType').addEventListener('change', e => {
            const isAge = e.target.value === 'Age';
            document.getElementById('ageFields').style.display = isAge ? '' : 'none';
            document.getElementById('distanceFields').style.display = isAge ? 'none' : '';
        });
    </script>
}